# Copy this file to .env and fill in your values. Never commit .env.

# Required: Anthropic API key for document classification and Q&A
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default inbox and library paths
# INBOX_PATH=./inbox
# LIBRARY_PATH=./library

# Optional: Telegram bot token (only required for `paperclaw telegram`).
# Get one from @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-...
